{
    "name": "offlinets",
    "version": "3.2.4-5",
    "description": "ping a service to check if it is up",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "test": "nyc --reporter=text mocha --require ts-node/register --ui bdd --timeout 999999 --colors ./test/offlineTsSpec.ts",
        "build": "node ./node_modules/gulp/bin/gulp build",
        "demo": "node ./node_modules/gulp/bin/gulp demo && ts-node ./demo/Server.ts",
        "prepare": "npm run build",
        "prepublishOnly": "npm test"
    },
    "files": [
        "dist/**/*"
    ],
    "nyc": {
        "extension": [
            ".ts"
        ],
        "include": [
            "src"
        ],
        "reporter": [
            "html"
        ],
        "all": true
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/InTimeTecGitHub/offlineTs"
    },
    "author": "Akhil Sasidharan",
    "license": "MIT",
    "devDependencies": {
        "@types/chai": "^4.3.20",
        "@types/express": "^4.17.25",
        "@types/mocha": "^9.1.1",
        "@types/node": "^16.11.41",
        "@types/sinon": "^10.0.13",
        "body-parser": "^1.20.3",
        "browserify": "^17.0.1",
        "chai": "^4.5.0",
        "express": "^4.22.3",
        "gulp": "^4.0.2",
        "gulp-typescript": "^5.0.1",
        "gulp-uglifyes": "npm:gulp-terser@^2.1.0",
        "mocha": "^10.0.0",
        "nyc": "^15.1.0",
        "sinon": "^14.0.0",
        "ts-node": "^10.9.2",
        "tsify": "^5.0.4",
        "typescript": "^4.7.4",
        "vinyl-buffer": "^1.0.1",
        "vinyl-source-stream": "^2.0.0"
    },
    "dependencies": {},
    "keywords": [
        "offlineTs",
        "offline",
        "offlinejs",
        "down",
        "servicedown",
        "ping"
    ]
}
